<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- GÖRÜNTÜLÜ ARAMA (9 Ağu 2026).
         CAMERA, Play'in "Kısıtlı İzinler" listesinde DEĞİLDİR (o liste
         SMS/Arama Kaydı/Erişilebilirlik/Tüm Dosyalar/Konum ve geniş medya
         izinleridir) — ayrı bir beyan formu gerekmiyor. Yine de belirgin
         açıklama + gizlilik politikası ŞART: kamera YALNIZ kullanıcı
         görüntülü arama başlattığında ya da kabul ettiğinde açılır
         (lib/gorusme/gorusme_surucu.dart: sesli aramada getUserMedia'ya
         'video': false gider, izin HİÇ istenmez).

         *** USE_FULL_SCREEN_INTENT BİLEREK YOK ***
         Android 14+ hedefleyen uygulamalarda bu izin yalnız arama/alarm
         uygulamalarına varsayılan veriliyor; diğerleri Play Console beyanı
         doldurmak zorunda ve ölçütü karşılamayanların yayını engelleniyor.
         dizi.jpg'nin temel işlevi dizi takibi: AAB 69 tam bu mantıkla
         reddedildi, ardından bir sürüm daha izin yüzünden reddedildi.
         Yerine gelen plan: Importance.MAX kanal + CATEGORY_CALL +
         setOngoing (lib/gorusme/arama_bildirim.dart). Telefon çalar ve
         titrer; yalnız kilit ekranını kaplamaz.
         BU İZİN GERİ EKLENMEYECEK — test/arama_bildirim_test.dart bunu
         manifest üzerinden doğruluyor.

         Ön plan servisi (FOREGROUND_SERVICE_MICROPHONE / _CAMERA) BU TURDA
         EKLENMEDİ: her ön plan servis türü Play Console'da ayrı bir
         "gösterim videosu" beyanı istiyor. Bugünkü davranış — uygulama arka
         plana alınınca arama düşebilir — eksik bir özelliktir, sessiz bir
         arıza değil; F2'de beyanla birlikte gelir. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <!-- WebRTC ses yönlendirmesi (hoparlör/ahize) ve ağ değişimi izleme.
         İkisi de "normal" izin: kullanıcıya sorulmaz, Play beyanı istemez.
         Bluetooth izinleri BİLEREK YOK: Bluetooth kulaklığa yönlendirme
         (SCO) Android 12+ta BLUETOOTH_CONNECT çalışma zamanı izni ister ve
         bu turda o özellik yok — istemediğimiz bir izni manifestte
         taşımak, mağaza incelemesinde açıklamak zorunda kalacağımız boş bir
         yüzeydir. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- MEDYA İZNİ YOK, BİLEREK (7 Ağu 2026).
         Dört medya/depolama izni buradan KALDIRILDI: Play Console AAB 69'u
         "Fotoğraf ve video izinlerine erişmek isteyen tüm geliştiricilerin,
         Google Play'i uygulamalarının temel işlevi hakkında bilgilendirmeleri
         gerekir" gerekçesiyle reddetti. Google geniş medya erişimini yalnız
         temel işlevi bu olan uygulamalara veriyor; "ara sıra medya ekleyen"
         uygulamalar Android Fotoğraf Seçici'ye yönlendiriliyor.
         Yorum eki artık sistem Fotoğraf Seçici'sinden geliyor
         (lib/ekranlar/medya_inceleme.dart + lib/foto_secici_io.dart);
         ACTION_PICK_IMAGES HİÇBİR izin istemez.
         HİÇBİR MEDYA/DEPOLAMA İZNİ GERİ EKLENMEYECEK — sürüm yine reddedilir.
         (İzin adları burada bilerek YAZILMADI: birleştirilmiş manifest'te
         "izin var mı" grep'i yanlış pozitif vermesin.) -->
    <application
        android:label="dizi.jpg"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- FCM: arka planda gelen bildirimler için varsayılan kanal -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="dizijpg_bildirim" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sosyal bağlantılar: uygulama derin bağlantı şemaları (Android 11+
             paket görünürlüğü olmadan launchUrl bunları çözemez) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="instagram"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="twitter"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tg"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
