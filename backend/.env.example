# Gerçek değerler sunucuda /opt/dizijpg/.env içinde (repoya girmez).
DB_SIFRE=guclu-bir-sifre-uret
JWT_SECRET=rastgele-64-karakter-uret
TMDB_TOKEN=tmdb-okuma-jetonunu-buraya

# Özel mesajların durağan (at-rest) şifrelemesi — AES-256-GCM, backend/kripto.js.
# base64 32 bayt üret:  openssl rand -base64 32
# ANAHTARI KAYBEDERSEN TÜM MESAJLAR KALICI OLARAK OKUNAMAZ HÂLE GELİR.
# Anahtarı parola yöneticisine kaydet; DB yedeği (pg_dump) anahtarı İÇERMEZ.
MESAJ_ANAHTARI=openssl-rand-base64-32-ciktisini-buraya
# Anahtar döndürünce eskisi buraya (yalnız okuma): k1:<base64>,k2:<base64>
#MESAJ_ANAHTARI_ESKI=
# Bilerek şifresiz çalışmak için (aksi hâlde anahtarsız açılış REDDEDİLİR):
#MESAJ_SIFRELEME=kapali
